# p4n4-dashboard service (docker-compose.yml). Copy to .env.

# Image tag: a dashboard release (pubspec.yaml version).
DASHBOARD_VERSION=1.5.0
DASHBOARD_PORT=8088
# Interface to publish on; set to a LAN address to keep it off other networks.
DASHBOARD_BIND=0.0.0.0

# Restart policy for every container: unless-stopped brings them back after a
# reboot or a Docker restart; "no" leaves them down until the next `docker compose up -d`
# (also: always, on-failure). Apply a change with `docker compose up -d`.
RESTART_POLICY=unless-stopped
# Host the browser uses for Grafana and other direct links. Leave empty to use
# the host the browser loaded the dashboard from.
DASHBOARD_HOST=

# Where nginx forwards /api/. p4n4-api v0.1 runs on the host: start it with
# P4N4_API_HOST=0.0.0.0 (or the docker bridge address) so the container can
# reach it. The assistant goes through it too (Ollama and Letta aren't proxied).
P4N4_API_UPSTREAM=http://host.docker.internal:8000

# Optional: serve Grafana from this origin at /grafana/, so the Grafana tab
# works over HTTPS (no mixed content). Grafana must serve from that sub path
# (GF_SERVER_SERVE_FROM_SUB_PATH=true, GF_SERVER_ROOT_URL ending in /grafana/).
#GRAFANA_UPSTREAM=http://p4n4-grafana:3000
#DASHBOARD_GRAFANA_BASE=/grafana/

# Optional: serve the Services tab's web apps from this origin at /svc/<id>/,
# so its viewer shows them over HTTPS and n8n shows at all (n8n refuses other
# sites' frames). These routes drop the service's X-Frame-Options for this
# origin only (other sites still can't frame them), keep WebSockets, and never
# pass on the p4n4-api token or basic auth credentials. Each service must
# serve from its path: NODE_RED_ADMIN_ROOT=/svc/node-red/ in the IoT .env,
# N8N_PATH=/svc/n8n/ in the AI .env. InfluxDB's UI can't serve from a sub path,
# so it always loads directly (http only).
#NODE_RED_UPSTREAM=http://p4n4-node-red:1880
#DASHBOARD_NODE_RED_BASE=/svc/node-red/
#N8N_UPSTREAM=http://p4n4-n8n:5678
#DASHBOARD_N8N_BASE=/svc/n8n/

# Optional: other origins the dashboard may frame (space-separated, e.g. a
# Grafana on another host set in Settings → Endpoints). By default the CSP
# allows this origin and each embeddable service's port on DASHBOARD_HOST
# (or the page's host) only.
#DASHBOARD_FRAME_ORIGINS=https://grafana.example.com

# Optional: a folder of video files served at /demo/, for a brand's demo
# cameras (brand.json video.demoCameras with urls like demo/cam-01.mp4), e.g.
# a project's clips. They play without the project's stacks running. Anyone
# who can open the dashboard can fetch them: see DASHBOARD_BASIC_AUTH.
#DASHBOARD_DEMO_DIR=./demo-clips

# Optional: HTTP basic auth in front of the whole dashboard (htpasswd lines,
# space-separated). Generate one with `make htpasswd NAME=admin`. Keep the
# value in single quotes so Compose leaves the $ signs alone.
#DASHBOARD_BASIC_AUTH='admin:$2y$05$…'

# Optional HTTPS front end (make up-tls, docker-compose.tls.yml). The site is
# the address browsers use; DASHBOARD_TLS is "internal" (Caddy's own CA:
# install its root certificate on clients) or an email for Let's Encrypt
# (public domain only). Use port 443 so the HTTP redirect lands on it.
#DASHBOARD_TLS_SITE=pi.lan
#DASHBOARD_TLS=internal
#DASHBOARD_TLS_PORT=443
#DASHBOARD_HTTP_PORT=80

# make up-local / make image: brand to build (p4n4, or an installed theme's id).
BRAND=p4n4
