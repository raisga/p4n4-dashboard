# Rendered at container start: ${VARS} below are the image's env vars
# (P4N4_API_UPSTREAM, GRAFANA_UPSTREAM, DASHBOARD_*).
#
# Ollama and Letta aren't proxied: the assistant goes through p4n4-api, which
# requires sign-in and decides who may use which model. nginx's own $variables are left alone because no env var has
# their names.

# What upstreams get as Authorization. Basic auth credentials
# (19-basic-auth.envsh) are for this proxy only and are dropped. With basic
# auth on, the browser's credentials occupy Authorization, so the app sends a
# service's own token (p4n4-api) in X-Upstream-Authorization instead, and it's
# moved back here (lib/api/auth.dart).
map $http_authorization $authorization_without_basic {
    ~*^basic\s  "";
    default     $http_authorization;
}
map $http_x_upstream_authorization $upstream_authorization {
    ""          $authorization_without_basic;
    default     $http_x_upstream_authorization;
}

# WebSocket upgrades (Grafana Live)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's embedded DNS. Upstreams are resolved per request, so nginx
    # starts (and serves the UI) even when a stack is down.
    resolver 127.0.0.11 valid=10s ipv6=off;

    include /etc/nginx/security_headers.conf;

    # Off unless DASHBOARD_BASIC_AUTH is set (19-basic-auth.envsh).
    auth_basic "${DASHBOARD_AUTH_REALM}";
    auth_basic_user_file /tmp/htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Settings defaults for the app (lib/core/runtime_config.dart). Values are
    # inserted without escaping: keep them plain URLs or paths.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security_headers.conf;
        return 200 '{"defaults":{"host":"${DASHBOARD_HOST}","apiBase":"${DASHBOARD_API_BASE}","grafanaBase":"${DASHBOARD_GRAFANA_BASE}"}}';
    }

    # p4n4-api keeps its own /api/v1 and /health paths.
    location /api/ {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/proxy_common.conf;
        # Assistant replies stream as they're generated, and can take minutes on a Pi.
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
    location = /health {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/proxy_common.conf;
    }

    # Optional: Grafana on this origin (GRAFANA_UPSTREAM set), so the Grafana
    # tab works over HTTPS without mixed content. Grafana must serve from the
    # sub path: GF_SERVER_SERVE_FROM_SUB_PATH=true and GF_SERVER_ROOT_URL
    # ending in /grafana/. The path is passed through unchanged.
    location /grafana/ {
        set $grafana "${GRAFANA_UPSTREAM}";
        if ($grafana = "") {
            return 404;
        }
        proxy_pass $grafana;
        # Grafana's own headers, not the dashboard's CSP (security_headers.conf)
        add_header X-Content-Type-Options nosniff always;
        proxy_http_version 1.1;
        # Grafana checks Origin against Host (CSRF), so keep the browser's Host
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $upstream_authorization;
        proxy_set_header X-Upstream-Authorization "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }

    # Entry points revalidate, so a new release is picked up right away.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security_headers.conf;
        # The SPA fallback below serves index.html for unknown paths too.
        try_files $uri /index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types application/javascript application/json application/wasm text/css image/svg+xml;
}
