# Rendered at container start: ${VARS} below are the image's env vars
# (P4N4_API_UPSTREAM, GRAFANA_UPSTREAM, NODE_RED_UPSTREAM, N8N_UPSTREAM,
# DASHBOARD_*; DASHBOARD_FRAME_SRC comes from 19-frame-src.envsh).
#
# Ollama and Letta aren't proxied: the assistant goes through p4n4-api, which
# requires sign-in and decides who may use which model. nginx's own $variables are left alone because no env var has
# their names.

# What upstreams get as Authorization. Basic auth credentials
# (19-basic-auth.envsh) are for this proxy only and are dropped. With basic
# auth on, the browser's credentials occupy Authorization, so the app sends a
# service's own token (p4n4-api) in X-Upstream-Authorization instead, and it's
# moved back here (lib/api/auth.dart).
map $http_authorization $authorization_without_basic {
    ~*^basic\s  "";
    default     $http_authorization;
}
map $http_x_upstream_authorization $upstream_authorization {
    ""          $authorization_without_basic;
    default     $http_x_upstream_authorization;
}

# Basic auth for /svc/node-red/. Once signed in, Node-RED's editor sends its
# own token as "Authorization: Bearer", which takes the place of the browser's
# basic auth credentials: those requests skip basic auth ("off"), and Node-RED
# (adminAuth, always on in the IoT stack) checks the token. Its login
# (auth/token) keeps basic auth, so its password can't be tried without it;
# Express matches routes ignoring case and a trailing slash, and so does this.
map "$uri|$http_authorization" $node_red_auth_realm {
    ~*^/svc/node-red/auth/token/?\|  "${DASHBOARD_AUTH_REALM}";
    ~*\|bearer\s                    off;
    default                         "${DASHBOARD_AUTH_REALM}";
}

# For the embedded services (embed_proxy.conf): these headers only when the
# service doesn't send its own, so a page never gets two.
map $upstream_http_x_content_type_options $embed_nosniff {
    ""      nosniff;
    default "";
}
map $upstream_http_referrer_policy $embed_referrer_policy {
    ""      same-origin;
    default "";
}

# WebSocket upgrades (Grafana Live, Node-RED, n8n)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

# The scheme the browser used: https behind the TLS front end (Caddy says so).
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Where the app may frame services from, besides this origin (the CSP's
# frame-src, security_headers.conf): each embeddable service's own origin
# (DASHBOARD_HOST, else the host the page came from, as $host), unless it's
# proxied here, plus DASHBOARD_FRAME_ORIGINS.
map $host $dashboard_frame_src {
    default "${DASHBOARD_FRAME_SRC}";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's embedded DNS. Upstreams are resolved per request, so nginx
    # starts (and serves the UI) even when a stack is down.
    resolver 127.0.0.11 valid=10s ipv6=off;

    include /etc/nginx/security_headers.conf;

    # Off unless DASHBOARD_BASIC_AUTH is set (19-basic-auth.envsh).
    auth_basic "${DASHBOARD_AUTH_REALM}";
    auth_basic_user_file /tmp/htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Settings defaults for the app (lib/core/runtime_config.dart). Values are
    # inserted without escaping: keep them plain URLs or paths.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security_headers.conf;
        return 200 '{"defaults":{"host":"${DASHBOARD_HOST}","apiBase":"${DASHBOARD_API_BASE}","grafanaBase":"${DASHBOARD_GRAFANA_BASE}","serviceUrls":{"node-red":"${DASHBOARD_NODE_RED_BASE}","n8n":"${DASHBOARD_N8N_BASE}"}}}';
    }

    # p4n4-api keeps its own /api/v1 and /health paths.
    location /api/ {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/proxy_common.conf;
        # Assistant replies stream as they're generated, and can take minutes on a Pi.
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
    location = /health {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/proxy_common.conf;
    }

    # Optional: Grafana on this origin (GRAFANA_UPSTREAM set), so the Grafana
    # tab works over HTTPS without mixed content. Grafana must serve from the
    # sub path: GF_SERVER_SERVE_FROM_SUB_PATH=true and GF_SERVER_ROOT_URL
    # ending in /grafana/. The path is passed through unchanged.
    location /grafana/ {
        set $grafana "${GRAFANA_UPSTREAM}";
        if ($grafana = "") {
            return 404;
        }
        proxy_pass $grafana;
        include /etc/nginx/embed_proxy.conf;
    }

    # Optional: the Services tab's web apps on this origin, at /svc/<id>/, so
    # the viewer works over HTTPS and with services that refuse other sites'
    # frames (n8n). Each is off (404) until its upstream is set, and must know
    # its path:
    #   Node-RED  NODE_RED_UPSTREAM, NODE_RED_ADMIN_ROOT=/svc/node-red/ (IoT .env);
    #             it serves from the path, passed through unchanged
    #   n8n       N8N_UPSTREAM, N8N_PATH=/svc/n8n/ (AI .env); it links to the
    #             path but serves from its root, so the path is stripped
    # InfluxDB's UI can't serve from a sub path, so it isn't proxied.
    location /svc/node-red/ {
        auth_basic $node_red_auth_realm;
        set $node_red "${NODE_RED_UPSTREAM}";
        if ($node_red = "") {
            return 404;
        }
        proxy_pass $node_red;
        include /etc/nginx/embed_proxy.conf;
    }
    location /svc/n8n/ {
        set $n8n "${N8N_UPSTREAM}";
        if ($n8n = "") {
            return 404;
        }
        rewrite ^/svc/n8n/(.*)$ /$1 break;
        proxy_pass $n8n;
        include /etc/nginx/embed_proxy.conf;
    }

    # Swagger UI and the schema it loads, from p4n4-api: the Services tab
    # opens it under the API's base URL, on this origin when that's here.
    location /swagger-ui {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/embed_proxy.conf;
    }
    location = /openapi.json {
        set $api ${P4N4_API_UPSTREAM};
        proxy_pass $api;
        include /etc/nginx/embed_proxy.conf;
    }

    # A brand's demo cameras (brand.json video.demoCameras, "demo/<file>"):
    # the video files in DASHBOARD_DEMO_DIR, mounted here. Video files only,
    # so a credits or notes file next to them isn't served.
    location /demo/ {
        location ~ ^/demo/[A-Za-z0-9_-]+\.(mp4|m4v|webm|ogv|mov)$ {
            root /usr/share/nginx;
            add_header Cache-Control "no-cache" always;
            include /etc/nginx/security_headers.conf;
        }
        return 404;
    }

    # Entry points revalidate, so a new release is picked up right away.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security_headers.conf;
        # The SPA fallback below serves index.html for unknown paths too.
        try_files $uri /index.html;
    }

    # The rest revalidate too (a 304 while unchanged): main.dart.js and the
    # assets (brand.json) keep their names across builds, and without this a
    # browser serves the last image's from cache for hours.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security_headers.conf;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types application/javascript application/json application/wasm text/css image/svg+xml;
}
